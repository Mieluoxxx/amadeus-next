{
  "name": "amadeus-next",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Code-Amadeus",
  "repository": "https://github.com/Code-Amadeus/Amadeus",
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Amadeus's TypeScript/Electron runtime with native Pi, Apple Speech and Fish Audio.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs --main-only",
    "assets:emote": "node scripts/provision-emote.mjs",
    "dev": "node scripts/dev.mjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:zip": "npm run build && electron-builder --mac zip",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:electron": "electron test/electron-acceptance.cjs",
    "test:dev": "node test/dev-acceptance.mjs",
    "test:scene": "node --experimental-strip-types test/scene-harness.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@msgpack/msgpack": "^3.1.2",
    "https-proxy-agent": "^7.0.6",
    "undici": "8.10.2",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.amadeus.next",
    "beforePack": "./scripts/before-pack.mjs",
    "productName": "Amadeus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/bin/**/*",
      "!dist/amadeus-assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "amadeus-assets",
        "filter": [
          "**/*",
          "!character/emote/**",
          "!emote/**"
        ]
      },
      {
        "from": "LICENSE",
        "to": "amadeus-assets/LICENSE"
      },
      {
        "from": "dist/bin",
        "to": "."
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "binaries": [
        "Contents/Resources/AmadeusSpeechRecognizer"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Amadeus uses the microphone for voice conversations.",
        "NSSpeechRecognitionUsageDescription": "Amadeus uses speech recognition to turn your voice into conversation."
      }
    }
  }
}
